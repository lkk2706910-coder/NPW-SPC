<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <!-- 改成你的 SQL Server。Integrated Security = 用 IIS App Pool 帳號連 DB。
         如果走 SQL 帳號:User ID=xxx;Password=xxx -->
    <add name="DefaultDb"
         connectionString="Data Source=YOUR_SQL_SERVER;Initial Catalog=YOUR_DATABASE;Integrated Security=True;Connection Timeout=15"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <!-- AI 助理 LLM gateway。沒設 AiApiKey 的話 AI panel 還是能看到 UI,
         但送訊息會回錯誤。AiApiKey 不要 commit,部署機器上的 web.config 才填真值。 -->
    <add key="AiGatewayUrl" value="http://10.11.197.97/openai/deployments/gpt-5.2/chat/completions" />
    <add key="AiApiKey" value="" />
    <add key="AiUserId" value="" />
    <add key="AiSystemPrompt" value="你是一個樂於助人的助理,回答請精簡、條列重點。" />
  </appSettings>
  <system.web>
    <!-- base64 圖片 case 會把 request body 撐大,這兩個值留高一點 -->
    <httpRuntime maxRequestLength="51200" executionTimeout="120" />
    <compilation debug="false" targetFramework="4.5" />
    <customErrors mode="Off" />
  </system.web>
  <system.webServer>
    <security>
      <requestFiltering>
        <!-- IIS 層 byte 上限,必須 >= maxRequestLength * 1024 -->
        <requestLimits maxAllowedContentLength="52428800" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
