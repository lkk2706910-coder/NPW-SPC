<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    連線字串。正式環境建議改成外置檔，避免帳密進版控：
        <connectionStrings configSource="connectionStrings.config" />
    並在同層放一個未納入版控的 connectionStrings.config
    （.gitignore 已排除該檔名）。
  -->
  <connectionStrings>
    <add name="AppDb"
         connectionString="Server=UMCESIDB02;Database=GPTPoCDB;User Id=GPTPoCDBUser;Password=DB02.2026;TrustServerCertificate=True;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <system.web>
    <compilation debug="false" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" maxRequestLength="51200" executionTimeout="120" />

    <!-- 對外環境請維持 RemoteOnly，錯誤細節不要送到瀏覽器 -->
    <customErrors mode="RemoteOnly" />
  </system.web>

  <!-- WaferMatch.html 會被明細頁以 iframe 反覆載入，關掉客戶端快取，改版後不會拿到舊檔 -->
  <location path="WaferMatch.html">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>

  <system.webServer>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="52428800" />
        <!-- EMST 填寫內容的 JSON 檔只能經由 TF2api/EmstNote.ashx 讀寫，不開放直接下載 -->
        <hiddenSegments>
          <add segment="emst_data" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>

</configuration>
