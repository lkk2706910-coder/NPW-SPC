<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <add name="EMST"
         connectionString="Server=UMCESIDB02;Database=GPTPoCDB;User Id=GPTPoCDBUser;Password=DB02.2026;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <appSettings>
    <add key="AiGatewayUrl" value="https://f12asddllmlog.umc.com/chat/completions" />
    <add key="AiModel" value="gpt-5.2" />
    <add key="AiApiKey" value="adf9bf29-9830-7172-7ee3-fb96a372cae0" />
    <add key="AiUserId" value="00047829" />
    <add key="AiSystemPrompt" value="你是設備工程小助手,協助使用者查詢與整理NPW data。回答請精簡、條列重點。" />
  </appSettings>

  <system.web>
    <httpRuntime maxRequestLength="51200" executionTimeout="120" />
    <!-- Parse source/markup files as UTF-8 so non-ASCII (Chinese) text is not
         mis-decoded as Big5/CP950, which can eat newlines and break parsing. -->
    <globalization fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8" culture="zh-TW" uiCulture="zh-TW" />
  </system.web>
  <system.webServer>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="52428800" />
        <!-- EMST 填寫內容的 JSON 檔只能經由 NPW_Alarm.aspx?op=emst 讀寫，不開放直接下載 -->
        <hiddenSegments>
          <add segment="emst_data" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
