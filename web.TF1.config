<?xml version="1.0" encoding="utf-8"?>
<!--
  TF1 專用 web.config（不含 AI 設定，TF1 不使用 AI）。
  部署時：把本檔放到 TF1 的資料夾並改名為 web.config。
  TF1 與 TF2 各自一個資料夾、各自一份 web.config，即不共用。
-->
<configuration>
  <connectionStrings>
    <add name="EMST"
         connectionString="Server=UMCESIDB02;Database=GPTPoCDB;User Id=GPTPoCDBUser;Password=DB02.2026;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <system.web>
    <httpRuntime maxRequestLength="51200" executionTimeout="120" />
    <!-- 以 UTF-8 解析原始檔，避免中文被當 Big5/CP950 吃掉換行 -->
    <globalization fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8" culture="zh-TW" uiCulture="zh-TW" />
  </system.web>
  <system.webServer>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="52428800" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
